#!/usr/bin/env node
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { openState, issuePairing } from "./src/cfl/state.mjs";
const [command, directory, id] = process.argv.slice(2);
if (!directory)
  throw new Error(
    "Usage: aru-selfhostctl pairing|devices|revoke DATA_DIR [DEVICE_ID]",
  );
const state = openState(resolve(directory));
try {
  if (command === "pairing") console.log(JSON.stringify(issuePairing(state)));
  else if (command === "devices")
    console.log(
      JSON.stringify(
        state.get("devices").map(({ credentialSHA256: _, ...d }) => d),
      ),
    );
  else if (command === "revoke") {
    const devices = state.get("devices"),
      device = devices.find((d) => d.deviceId === id);
    if (!device) throw Error("Unknown device");
    device.revokedAt ??= Date.now();
    state.put("devices", devices);
    console.log("Device revoked");
  } else
    throw new Error(
      "Unsupported command; updates require an explicit fork package",
    );
} finally {
  state.close();
}
