[Unit]
Description=CFL Aru HTTP access node
After=network.target

[Service]
Type=simple
# Run as the operator-selected CFL service owner; set paths in a local override.
ExecStart=/opt/aru-cfl/current/run-node.sh --data-dir /var/lib/aru-cfl --cfl-origin http://127.0.0.1:3082 --base-url http://127.0.0.1:8787
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
